<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <FrameLayout
        android:id="@+id/jarContainer"
        android:layout_width="76dp"
        android:layout_height="150dp"
        android:background="@drawable/bg_jar_outline"
        android:clipChildren="true"
        android:clipToOutline="true"
        android:layout_marginBottom="8dp">

        <View
            android:id="@+id/jarFill"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_jar_fill"/>

        <TextView
            android:id="@+id/tvJarPct"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="0%"/>
    </FrameLayout>

    <TextView
        android:id="@+id/tvGoalName"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvGoalAmounts"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/slate_light"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="6dp"/>

    <Button
        android:id="@+id/btnAddMoney"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@drawable/bg_chip_mint"
        android:text="+ Add"
        android:textColor="@color/mint"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"/>

</LinearLayout>
